# 复制这个文件为 keystore.properties,填入你自己的签名信息。
# keystore.properties 已被 .gitignore 忽略,不要提交到仓库。
#
# storeFile 可以写绝对路径,也可以用 / 分隔的相对路径:
#   storeFile=C:/Users/你的用户名/keystore/release.jks
# 密码里有特殊字符时不用加引号。
#
# 查看别名(需要输入 keystore 密码):
#   keytool -list -v -keystore release.jks

storeFile=C:/path/to/your-release.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
